# Server
PORT=5000

# Comma-separated list of allowed origins (your Netlify URL + localhost for dev)
FRONTEND_URL=http://localhost:5173,https://your-site.netlify.app

# ---- Email (Brevo Transactional Email HTTP API) ----
# We use Brevo's HTTP API (not SMTP) because most free hosting tiers
# (Render, Railway, etc.) block outbound SMTP ports 25/465/587.
#
# 1. Get your API key from https://app.brevo.com/settings/keys/api
#    (starts with "xkeysib-")
# 2. Verify a sender email at https://app.brevo.com/senders
#    (Brevo will only let you send FROM a verified address)

BREVO_API_KEY=xkeysib-your-api-key-here
FROM_EMAIL=your-verified-sender@example.com

# Where the "you got a new message" notification email should be delivered
OWNER_EMAIL=youraddress@gmail.com
