# Server
PORT=5000

# Allowed origins, comma se alag (Vercel Domains wala URL + localhost dev ke liye). Aakhir mein "/" nahi.
# e.g. https://my-portflio-phi.vercel.app,http://localhost:5173
FRONTEND_URL=

# ---- Email (Brevo Transactional Email HTTP API) ----
# 1. API key: https://app.brevo.com/settings/keys/api  (xkeysib- se shuru hoti hai)
# 2. Sender verify karein: https://app.brevo.com/senders
BREVO_API_KEY=
FROM_EMAIL=

# "New message" notification yahan aayegi
OWNER_EMAIL=

# ---- MongoDB (likes, comments, projects, uploaded pics) ----
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio
MONGO_URI=

# ---- Admin ----
# /admin panel (projects add/edit/delete/pic) aur comments delete — dono isi key se.
# Koi bhi mazboot password chunein, kisi ko share na karein.
ADMIN_KEY=
